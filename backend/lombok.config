# Stop Lombok looking further up the tree for config.
config.stopBubbling = true

# Lombok generates the constructor for @RequiredArgsConstructor, so annotations that belong
# on a constructor *parameter* have to be copied there explicitly. Without this, @Lazy on a
# field is silently dropped and self-injection fails as a circular reference at startup.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
