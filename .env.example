# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- Database -----------------------------------------------------------------------
DB_USER=fintrack
DB_NAME=fintrack
DB_PORT=5432
# Required. Any non-empty value works locally.
DB_PASSWORD=change-me-locally

# --- API ----------------------------------------------------------------------------
API_PORT=8080

# Required. Base64, at least 256 bits of key material for HS256.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=

# Comma-separated browser origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Running the API outside Docker -------------------------------------------------
# When the API runs on the host rather than in compose, point it at the published port:
# DATABASE_URL=jdbc:postgresql://localhost:5432/fintrack
