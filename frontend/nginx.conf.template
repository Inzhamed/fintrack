# Rendered by the nginx image's entrypoint at start-up: ${API_UPSTREAM} is substituted from
# the environment, so one image serves both compose - where the API answers to "api" - and
# Kubernetes, where the Service name carries the Helm release prefix. envsubst only replaces
# variables that are actually set, so nginx's own $host / $scheme / $uri survive intact.
server {
    listen 8080;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Security headers. The API sets its own; these cover what the browser applies to the
    # document itself.
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Hashed filenames are content-addressed, so they can be cached indefinitely.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # index.html must never be cached, or a returning visitor keeps loading the old build's
    # asset names after a deploy and gets a blank page.
    location = /index.html {
        add_header Cache-Control "no-cache, must-revalidate";
    }

    # Same-origin proxy to the API, so the browser makes no cross-origin request and CORS
    # never enters the picture in production.
    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # The API reads the first entry of this to record which address a session came from.
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The WebSocket upgrade. Without the Upgrade and Connection headers nginx proxies it
    # as an ordinary HTTP request and the handshake fails. The long read timeout keeps an
    # idle socket from being closed between heartbeats.
    location /ws {
        proxy_pass http://${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 3600s;
    }

    # Client-side routing: every unknown path is a React route, not a missing file.
    # Without this, refreshing on /transactions returns a 404 from nginx.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
